{
  "name": "automation-testing",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=guest-* --project=chromium --project=firefox --project=webkit",
    "test:smoke": "playwright test --project=guest-chromium --project=chromium --grep @smoke",
    "test:login": "playwright test src/modules/auth/tests/guest/login.spec.ts",
    "test:contracts": "playwright test --project=contracts",
    "test:headed": "playwright test --project=guest-chromium --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChndnSnghGen/Automation-Testing.git"
  },
  "keywords": [],
