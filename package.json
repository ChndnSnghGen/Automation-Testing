  "bugs": {
    "url": "https://github.com/ChndnSnghGen/Automation-Testing/issues"
  },
  "homepage": "https://github.com/ChndnSnghGen/Automation-Testing#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  }
